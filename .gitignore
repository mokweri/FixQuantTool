# ========================
# FixQuantTool .gitignore
# ========================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ---- Virtual environments ----
venv/
ENV/
.python-version

# ---- IDE ----
.idea/
.vscode/
*.swp
*.swo

# ---- IPython / Jupyter ----
.ipynb_checkpoints/

# ---- Env files ----
.env

# ---- Model checkpoints & outputs ----
qat_models/
checkpoints/
outputs/
saved_models-FP/
# Mutable model-zoo candidates contain machine-specific run paths.
model_zoo/.candidates/
# Release metadata remains tracked; heavyweight checkpoint binaries do not.
model_zoo/releases/**/qat/model_best.pth.tar
*.pth
*.pth.tar
*.onnx

# ---- Binary data files ----
hw_data_files/
*.data

# ---- Logs & HPC ----
logs/
*.out
*.log

# ---- Misc ----
*.tar
